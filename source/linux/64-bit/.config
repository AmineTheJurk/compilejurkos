#
# JurkOS 64-bit Linux 6.14.0 Kernel Configuration
# Target: x86_64 (Linux 6.14.0 upstream)
# All storage built-in, all Wi-Fi built-in, Framebuffer drivers kept built-in,
# ONLY DRM drivers as loadable modules.
#

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_INSTRUCTION_DECODER=y
CONFIG_OUTPUT_FORMAT="elf64-x86-64"
CONFIG_ARCH_DEFCONFIG="arch/x86/configs/x86_64_defconfig"
CONFIG_LOCKDEP_SUPPORT=y
CONFIG_STACKTRACE_SUPPORT=y
CONFIG_MMU=y
CONFIG_GENERIC_BUG=y
CONFIG_GENERIC_CALIBRATE_DELAY=y
CONFIG_ARCH_SUPPORTS_UPROBES=y
CONFIG_PGTABLE_LEVELS=4

#
# Low Memory & Minimal Footprint (40MB-50MB RAM Target)
#
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_SLUB=y
CONFIG_SLUB_TINY=y
CONFIG_BASE_FULL=n
CONFIG_BASE_SMALL=1
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_PRINTK=y
CONFIG_PRINTK_SAFE_LOG_BUF_SHIFT=12
CONFIG_LOG_BUF_SHIFT=14

#
# Processor: x86-64-v1 baseline architecture
#
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_GENERIC_CPU=y
CONFIG_X86_EXTENDED_PLATFORM=n
CONFIG_SCHED_OMIT_FRAME_POINTER=y
CONFIG_PREEMPT_NONE=y

#
# Executable Formats (Runs BOTH 64-bit and 32-bit user-space binaries!)
#
CONFIG_BINFMT_ELF=y
CONFIG_COMPAT_BINFMT_ELF=y
CONFIG_IA32_EMULATION=y
CONFIG_X86_X32=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEFAULT_HOSTNAME="jurkos"
CONFIG_LOCALVERSION="-x86_64"

#
# Loadable Module Support (Used EXCLUSIVELY for DRM GPU Drivers!)
#
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

#
# Compression (XZ for smallest bzImage size)
#
CONFIG_KERNEL_XZ=y

#
# Block Layer & Core Storage (ALL BUILT-IN)
#
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SCSI=y
CONFIG_SCSI_SCAN_ASYNC=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y

# ATA / SATA / IDE Storage (ALL BUILT-IN)
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_GENERIC=y
CONFIG_PATA_AMD=y
CONFIG_PATA_OLDPIIX=y
CONFIG_PATA_MPIIX=y
CONFIG_PATA_SIS=y
CONFIG_PATA_VIA=y
CONFIG_PATA_SCH=y

# NVMe Storage (BUILT-IN)
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# VirtIO Storage & Bus (BUILT-IN for QEMU / KVM)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y

#
# USB & Removable Storage (ALL BUILT-IN)
#
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

#
# Input & HID (BUILT-IN)
#
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

#
# Serial & Console (BUILT-IN)
#
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_VT_CONSOLE=y
CONFIG_HW_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

#
# Framebuffer Drivers (KEEP BUILT-IN FOR RELIABLE BOOT DISPLAY)
#
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FB_SIMPLE=y
CONFIG_FB_UVESA=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_MODE_HELPERS=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

#
# DRM (Direct Rendering Manager) - BUILT-IN CORE!
# Intel, AMD, and VirtIO drivers are built-in; others are loadable modules (.ko)
#
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_TTM=y
CONFIG_DRM_BUDDY=y
CONFIG_DRM_SCHED=y

# Built-in DRM Drivers (Direct Rendering Manager, Intel, AMD, VirtIO)
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y

# Other DRM Drivers (Modules)
CONFIG_DRM_BOCHS=m
CONFIG_DRM_QXL=m
CONFIG_DRM_CIRRUS_QEMU=m
CONFIG_DRM_SIMPLEDRM=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_RADEON=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_AST=m
CONFIG_DRM_MGAG200=m

#
# Wireless / Wi-Fi Subsystem & Drivers (ALL BUILT-IN)
#
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_NET_RADIO=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IPW2100=y
CONFIG_IPW2200=y
CONFIG_IWLEG=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_IWLWIFI=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8180=y
CONFIG_RTL8187=y
CONFIG_RTL_CARDS=y
CONFIG_RTL8192CE=y
CONFIG_RTL8192CU=y
CONFIG_RTL8192SE=y
CONFIG_RTL8192DE=y
CONFIG_RTL8723AE=y
CONFIG_RTL8723BE=y
CONFIG_RTL8188EE=y
CONFIG_RTL8821AE=y
CONFIG_RTLBTCOEXIST=y
CONFIG_RTL8XXXU=y
CONFIG_RTW88=y
CONFIG_RTW88_8822BE=y
CONFIG_RTW88_8822CE=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_HTC=y
CONFIG_CARL9170=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_B43=y
CONFIG_B43LEGACY=y
CONFIG_BRCMSMAC=y
CONFIG_BRCMFMAC=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=y
CONFIG_RT2800PCI=y
CONFIG_RT2800USB=y
CONFIG_RFKILL=y

#
# Wired Ethernet Networking (ALL BUILT-IN)
#
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E100=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_8139TOO=y
CONFIG_8139CP=y
CONFIG_R8169=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_NET_VENDOR_MARVELL=y
CONFIG_SKY2=y
CONFIG_VIRTIO_NET=y

#
# Filesystems (ALL BUILT-IN)
#
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FILE_LOCKING=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NTFS3_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_FUSE_FS=y
CONFIG_BTRFS_FS=y

#
# Virtual Filesystems (ALL BUILT-IN)
#
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CONFIGFS_FS=y
