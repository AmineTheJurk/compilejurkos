#
# JurkOS Buildroot Configuration
# Automatically generated configuration with standard Graphics & OpenGL stack
#

#
# Target Architecture
#
BR2_x86_64=y
BR2_ARCH="x86_64"
BR2_ENDIAN="LITTLE"
BR2_GCC_TARGET_ARCH="x86-64"

#
# Toolchain Settings (Required for Mesa3D C++ & Gallium Drivers)
#
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_TOOLCHAIN_HAS_THREADS=y
BR2_TOOLCHAIN_HAS_THREADS_NPTL=y
BR2_USE_WCHAR=y
BR2_ENABLE_LOCALE=y

#
# CCache Settings
#
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"

#
# Linux Kernel Configuration
#
# Linux Kernel -> Kernel configuration -> Device Drivers -> Graphics support
# [*] Direct Rendering Manager (XFree86 4.1.0 and higher) via DRI
# [*] Intel 8xx/9xx/G3x/G4x/HD Graphics
# [*] AMD GPU
# [*] Virtio GPU driver
#
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.14"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/jurkos/linux.config"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

#
# Target packages -> Graphic libraries and applications
#

# Target packages -> Graphic libraries and applications -> [*] libdrm
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_HAS_ATOMIC=y
BR2_PACKAGE_LIBDRM_ENABLE_ATOMIC=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y

# Target packages -> Graphic libraries and applications -> libdrm -> [*] intel
BR2_PACKAGE_LIBDRM_INTEL=y

# Target packages -> Graphic libraries and applications -> libdrm -> [*] radeon
BR2_PACKAGE_LIBDRM_RADEON=y

# Target packages -> Graphic libraries and applications -> [*] mesa3d
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_HAS_LIBGBM=y
BR2_PACKAGE_PROVIDES_LIBGBM="mesa3d"
BR2_PACKAGE_HAS_LIBEGL=y
BR2_PACKAGE_PROVIDES_LIBEGL="mesa3d"
BR2_PACKAGE_HAS_LIBGLES=y
BR2_PACKAGE_PROVIDES_LIBGLES="mesa3d"
BR2_PACKAGE_HAS_LIBGL=y
BR2_PACKAGE_PROVIDES_LIBGL="mesa3d"

# Target packages -> Graphic libraries and applications -> mesa3d -> [*] Enable Gallium driver
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER=y

# Target packages -> Graphic libraries and applications -> mesa3d -> [*] Enable OpenGL EGL
BR2_PACKAGE_MESA3D_OPENGL_EGL=y

# Target packages -> Graphic libraries and applications -> mesa3d -> [*] Enable OpenGL ES
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Target packages -> Graphic libraries and applications -> mesa3d -> [*] Enable GBM
BR2_PACKAGE_MESA3D_GBM=y

# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers
# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers -> [*] swrast
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y

# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers -> [*] virgl
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y

# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers -> [*] iris
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y

# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers -> [*] radeonsi
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y

# Target packages -> Graphic libraries and applications -> mesa3d -> Gallium drivers -> [*] nouveau
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y

# Target packages -> Graphic libraries and applications -> mesa3d demos
BR2_PACKAGE_MESA3D_DEMOS=y

#
# Core System & Utilities
#
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_IW=y

#
# Filesystem images
#
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_EXT2_LABEL="JURKOS_ROOT"
